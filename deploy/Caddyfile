

# PUBLIC_HOST comes from .env.prod. Caddy picks the certificate automatically:
# a local/internal name (localhost, an IP, *.nip.io on some setups) -> its own CA;
# a real public domain -> a free Let's Encrypt certificate. No extra config needed.
{$PUBLIC_HOST} {
	encode gzip

	# API -> Spring Boot
	@api path /auth/* /plan /plan/* /subscription /subscription/* /user/* /actuator/*
	handle @api {
		reverse_proxy app:8080
	}

	# Everything else -> static frontend
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}
