# Copy to .env and fill in.  `docker compose` reads .env automatically.
#   cp .env.example .env

# ---- Database ----
# Hostname is the compose service name ("postgres").
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/billing
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# ---- RabbitMQ (events) ----
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# ---- JWT ----
# REQUIRED. Generate one (hex avoids the / and + that break .env parsing):
#   openssl rand -hex 48
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_48
JWT_EXPIRATION=3600000

# ---- Bootstrap admin ----
# Optional: on startup, if this e-mail has no account yet, one is created with
# ROLE_ADMIN. Leave blank to skip. Set both to create the first admin.
ADMIN_EMAIL=admin@billing.local
ADMIN_PASSWORD=

# ---- App ----
SERVER_PORT=8080
