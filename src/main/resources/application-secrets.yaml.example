# Copy to application-secrets.yaml (gitignored) for local development.
# In containers / production these come from environment variables instead
# (JWT_SECRET, SPRING_DATASOURCE_PASSWORD, SPRING_RABBITMQ_PASSWORD).

jwt:
  # openssl rand -hex 48
  secret: change-me-local-dev-only
  expiration: 3600000

spring:
  datasource:
    password: postgres   # matches docker-compose.yaml POSTGRES_PASSWORD
  rabbitmq:
    password: guest      # matches docker-compose.yaml RABBITMQ_DEFAULT_PASS
